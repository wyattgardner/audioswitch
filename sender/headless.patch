+//go:build headless
+
+// Headless sender: the same capture and server code as the GUI's Sender
+// mode, started at launch with no window. Build with -tags headless.
+//
+//	AudioOverIP-headless.exe [-port 8080]
+//
+// Logs go to %APPDATA%\ElTheLedge\AudioOverIP\logs. Stop it by ending the process.
+package main
+
+import (
+	"flag"
+	"log"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"runtime"
+	"time"
+
+	"AuOvIP/wcatools"
+
+	"github.com/go-ole/go-ole"
+)
+
+// The GUI build defines these in main.go.
+var app = NewApp()
+var serverLogger *Logger
+var clientLogger *Logger
+
+// keepMTA parks one OS thread in COM's multithreaded apartment for the life of
+// the process. The HTTP handlers (/getAudioConfig, /getAudioDevices) call
+// wcatools on threads that never initialize COM; they only work while some
+// thread holds the process in the MTA. The GUI build gets that from WebView2.
+func keepMTA() error {
+	ready := make(chan error, 1)
+	go func() {
+		runtime.LockOSThread()
+		ready <- ole.CoInitializeEx(0, ole.COINIT_MULTITHREADED)
+		select {}
+	}()
+	return <-ready
+}
+
+// watchPlaybackDevice logs whenever the default playback device appears, changes or goes away.
+// With no active playback device Windows renders nothing, loopback has nothing to capture and
+// /getAudioConfig answers 500, so say so plainly in the log.
+func watchPlaybackDevice() {
+	last := "unset"
+	for {
+		name := ""
+		if cfg, err := wcatools.GetDefaultDeviceInfo(); err == nil {
+			name = cfg.Name
+		}
+		if name != last {
+			if name == "" {
+				serverLogger.Errorf("no active playback device: Windows has nothing to play to, so there is no audio to capture. Plug in or enable an output device.")
+			} else {
+				serverLogger.Infof("default playback device: %s", name)
+			}
+			last = name
+		}
+		time.Sleep(10 * time.Second)
+	}
+}
+
+func main() {
+	_ = LoadConfig()
+	port := flag.String("port", serverConfig.Port, "TCP port to listen on")
+	flag.Parse()
+
+	// InitLogger puts relative paths under the app's config dir
+	// (%APPDATA%\ElTheLedge\AudioOverIP), like the GUI's logs.
+	var err error
+	serverLogger, err = InitLogger(filepath.Join("logs", "headless-server.log"), LevelInfo, 1024*1024)
+	if err != nil {
+		log.Fatalln("Could not init serverLogger:", err)
+	}
+	clientLogger = serverLogger
+
+	if err := keepMTA(); err != nil {
+		serverLogger.Errorf("CoInitializeEx(MTA) failed: %v", err)
+		os.Exit(1)
+	}
+	go watchPlaybackDevice()
+
+	// Nobody reads the GUI's stats channel here; drain it so the stats
+	// goroutine never blocks.
+	go func() {
+		for range serverStats {
+		}
+	}()
+
+	sig := make(chan os.Signal, 1)
+	signal.Notify(sig, os.Interrupt)
+	go func() {
+		<-sig
+		stopServer()
+		os.Exit(0)
+	}()
+
+	serverLogger.Infof("headless sender listening on :%s", *port)
+	// Same as the GUI: the server (and its COM thread) runs on its own goroutine.
+	done := make(chan struct{})
+	go func() {
+		startServer(*port) // blocks until stopped
+		close(done)
+	}()
+	<-done
+	serverLogger.Errorf("headless sender stopped")
+	os.Exit(1)
+}
diff --git a/wcatools/com.go b/wcatools/com.go
index 4330847..476221c 100644
--- a/wcatools/com.go
+++ b/wcatools/com.go
@@ -12,6 +12,11 @@ import (
 func InitCOM() error {
 	// Initialize COM for this thread.
 	if err := ole.CoInitialize(0); err != nil {
+		// S_FALSE: COM was already initialized on this thread. That is a
+		// success code (still balanced by CoUninitialize), not a failure.
+		if oleErr, ok := err.(*ole.OleError); ok && oleErr.Code() == 1 {
+			return nil
+		}
 		return err
 	}
 	return nil
